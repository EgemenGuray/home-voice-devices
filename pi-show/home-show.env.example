# Copy to /etc/home-show.env on the Pi (mode 600). Fake values.
KIOSK_USER=kiosk
SATELLITE_NAME="Living room show"
# Home Assistant VM's LAN address (only this host may reach the satellite port)
HA_HOST_IP=192.0.2.10
# The Show dashboard from home-assistant-config (dashboards/show.yaml, theme "Home Show").
# Log in once as a dedicated non-admin, local-only HA user. `?kiosk` hides HA's header and
# sidebar and needs the kiosk-mode frontend plugin (HACS) on HA.
DASHBOARD_URL=http://homeassistant.local:8123/show-living-room/0?kiosk
# ALSA device of the XVF3800 (see `arecord -L`)
MIC_DEVICE=plughw:CARD=Array,DEV=0
SND_DEVICE=plughw:CARD=Array,DEV=0
WAKE_WORD=ok_nabu
